<?xml version="1.0"?>
<Container version="2">
  <Name>Ubuntu-XRDP</Name>
  <Repository>ghcr.io/h3xx3r/xubuntu-xrdp-fuse-de:latest</Repository>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Overview>Ubuntu 24.04 XFCE XRDP Multiuser Desktop mit deutscher Oberfläche, Gastreset, optional passwortlosen Gastkonten, FUSE-Laufwerken, RDP Audio/Mikrofon, GPU und CUPS-Netzwerkdruckern.</Overview>
  <Category>Tools:</Category>
  <ExtraParams>--shm-size=2g --cap-add=SYS_ADMIN --label net.unraid.docker.managed=dockerman --label net.unraid.docker.shell=bash</ExtraParams>

  <Config Name="RDP Port" Target="3389" Default="3389" Mode="tcp" Description="RDP Port" Type="Port" Display="always" Required="true" Mask="false">3389</Config>
  <Config Name="Home Verzeichnis" Target="/home" Default="/mnt/user/appdata/ubuntu-xrdp/home" Mode="rw" Description="Persistente Benutzerprofile und Drucker-Golden-Profile" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/ubuntu-xrdp/home</Config>
  <Config Name="RDP Benutzer" Target="RDP_USERS" Default="admin:1000:1000:1;guest:1001:1001:0" Mode="" Description="Format: name:uid:gid:admin" Type="Variable" Display="always" Required="true" Mask="false">admin:1000:1000:1;guest:1001:1001:0</Config>
  <Config Name="Master Passwort" Target="RDP_MASTER_PASSWORD" Default="changeme" Mode="" Description="Passwort für Admin-Konten und optional Standardkonten - unbedingt ändern" Type="Variable" Display="always" Required="true" Mask="true">changeme</Config>
  <Config Name="Standardkonten zurücksetzen" Target="RESET_STANDARD_USERS" Default="1" Mode="" Description="1 = Reset bei neuer Sitzung, 0 = persistent" Type="Variable" Display="always" Required="true" Mask="false">1</Config>
  <Config Name="Gast ohne Passwort" Target="RDP_PASSWORDLESS_STANDARD_USERS" Default="1" Mode="" Description="1 = alle Konten mit admin=0 melden sich mit leerem Passwort an; Admin-Konten behalten das Master-Passwort. 0 = Standardkonten nutzen ebenfalls das Master-Passwort." Type="Variable" Display="always" Required="true" Mask="false">1</Config>
  <Config Name="RDP Audio" Target="RDP_AUDIO_ENABLED" Default="1" Mode="" Description="1 = Lautsprecher und Mikrofon über RDP" Type="Variable" Display="always" Required="true" Mask="false">1</Config>
  <Config Name="Netzwerkdrucker" Target="RDP_PRINTERS" Default="" Mode="" Description="user|queue|uri|model|options; mehrere Drucker mit ; trennen" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Druckerprofile neu erzeugen" Target="PRINTER_PROFILE_REFRESH" Default="0" Mode="" Description="1 erzeugt Golden Profiles neu; danach wieder auf 0" Type="Variable" Display="advanced" Required="true" Mask="false">0</Config>
  <Config Name="Maximale Sitzungen" Target="MAX_SESSIONS" Default="20" Mode="" Description="Maximale gleichzeitige XRDP Sitzungen" Type="Variable" Display="advanced" Required="true" Mask="false">20</Config>
  <Config Name="Getrennte Sitzungen beenden" Target="KILL_DISCONNECTED" Default="true" Mode="" Description="true oder false" Type="Variable" Display="advanced" Required="true" Mask="false">true</Config>
  <Config Name="Disconnected Timeout" Target="DISCONNECTED_TIME_LIMIT" Default="60" Mode="" Description="Sekunden bis getrennte Sitzung beendet wird" Type="Variable" Display="advanced" Required="true" Mask="false">60</Config>
  <Config Name="Idle Timeout" Target="IDLE_TIME_LIMIT" Default="0" Mode="" Description="0 = deaktiviert" Type="Variable" Display="advanced" Required="true" Mask="false">0</Config>
  <Config Name="Session Policy" Target="SESSION_POLICY" Default="Default" Mode="" Description="XRDP Session Policy" Type="Variable" Display="advanced" Required="true" Mask="false">Default</Config>
  <Config Name="Zeitzone" Target="TZ" Default="Europe/Berlin" Mode="" Description="Linux TZ Name" Type="Variable" Display="always" Required="true" Mask="false">Europe/Berlin</Config>
  <Config Name="FUSE" Target="/dev/fuse" Default="/dev/fuse" Mode="" Description="RDP Client-Laufwerksumleitung" Type="Device" Display="advanced" Required="false" Mask="false">/dev/fuse</Config>
</Container>
